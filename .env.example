# Copy to .env (gitignored) and fill in. Never commit .env.
# Full steps: email-app/README.md

# outlook = classic Outlook app on Windows (no password needed)
# smtp    = Gmail / Outlook.com / anything with SMTP
SEND_VIA=smtp

# --- classic Outlook (SEND_VIA=outlook) ---
# Optional: which signed-in account to send from (default: first one)
OUTLOOK_ACCOUNT=

# --- SMTP (SEND_VIA=smtp) ---
# Gmail: smtp.gmail.com / 465, password = 16-char App Password
# Outlook.com: smtp-mail.outlook.com / 587; Microsoft 365: smtp.office365.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=
SMTP_FROM=you@example.com
SMTP_FROM_NAME=Your Name
